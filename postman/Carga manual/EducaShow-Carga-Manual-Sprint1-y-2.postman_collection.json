  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now=new Date();",
          "const date=(d)=>d.toISOString().slice(0,10);",
          "const start=new Date(now.getFullYear(),0,1);const end=new Date(now.getFullYear(),11,31);",
          "const limit=new Date(now);limit.setDate(limit.getDate()+60);",
          "const due=new Date(now.getFullYear(),now.getMonth()+1,10);",
          "const taskDue=new Date(now);taskDue.setDate(taskDue.getDate()+30);taskDue.setHours(23,59,0,0);",
          "pm.collectionVariables.set('inicioPeriodo',date(start));pm.collectionVariables.set('finPeriodo',date(end));",
          "pm.collectionVariables.set('inicioMatricula',date(now));pm.collectionVariables.set('limiteMatricula',date(limit));",
          "pm.collectionVariables.set('fechaLimiteTarea',date(taskDue)+'T23:59:00');",
          "pm.collectionVariables.set('primerVencimiento',date(due));",
          "pm.collectionVariables.set('fechaSesion',date(now));"
        ]
      }
    }
  ],

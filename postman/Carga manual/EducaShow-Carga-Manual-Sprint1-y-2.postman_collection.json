              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const usadas=new Set(pm.response.json().filter(x=>x.gradoNumero===1).map(x=>x.nombre));",
                  "const nombres='ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').concat(Array.from({length:26},(_,a)=>Array.from({length:26},(_,b)=>String.fromCharCode(65+a)+String.fromCharCode(65+b))).flat());",
                  "const libre=nombres.find(n=>!usadas.has(n));if(!libre)throw new Error('No hay nombres libres para una sección de primer grado');",
                  "pm.collectionVariables.set('seccionNombre',libre);"

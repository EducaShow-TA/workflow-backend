                  "pm.collectionVariables.set('seedTag',n);",
                  "pm.collectionVariables.set('dniAlumno1','7'+n+'1');pm.collectionVariables.set('dniAlumno2','7'+n+'2');",
                  "pm.collectionVariables.set('dniApoderado1','4'+n+'1');pm.collectionVariables.set('dniApoderado2','4'+n+'2');",
                  "const code=parseInt(n,10)%676;pm.collectionVariables.set('seccionNombre',String.fromCharCode(65+Math.floor(code/26))+String.fromCharCode(65+(code%26)));"
                ]

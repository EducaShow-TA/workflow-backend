                  "pm.collectionVariables.set('csvBoundary',b);",
                  "pm.collectionVariables.set('csvContenido',[",
                  "'rol,dni,nombres,apellido_paterno,apellido_materno,correo,username,telefono,fecha_nacimiento,dni_apoderado,parentesco',",

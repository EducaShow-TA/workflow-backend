# Configuracion local del backend. Copiar a .env y completar:   cp .env.example .env
# .env no se versiona (esta en .gitignore). Nunca pongas aqui credenciales de un entorno compartido o de produccion.
# Formato .properties: CLAVE=valor, sin comillas ni espacios alrededor del "=".
# Las variables exportadas en la terminal o en el IDE tienen prioridad sobre este archivo.

# Base de datos: MySQL local en Docker (ver docs/despliegue-local.md, seccion 2)
DB_URL=jdbc:mysql://localhost:3306/colegio_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=colegio
DB_PASSWORD=colegio_local

# Obligatoria. Clave Base64 de al menos 256 bits para firmar los JWT. Generar una propia con:
#   openssl rand -base64 32
# JWT_SECRET=

# Opcional. Correo para la recuperacion de contrasena. Con Gmail, usar una contrasena de aplicacion propia.
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Opcionales (valores por defecto en application.yml)
# PORT=8080
# JWT_EXPIRATION_MS=86400000
# MAX_LOGIN_ATTEMPTS=3
# LOCK_TIME_MINUTES=15
# LOG_FILE=logs/colegio-backend.log
